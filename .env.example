# Copy to .env (git-ignored). Read by the backend only; never commit real values.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1

# Optional model overrides (defaults shown):
# META_SPARK_MODEL=muse-spark-1.3
# META_WONDER_MODEL=muse-wonder-1.0
# META_IMAGE_MODEL=muse-image-1.0
# META_SAM_MODEL=sam-3.1

# Max Meta Model API calls per listing job:
# VRE_META_MAX_CALLS=400

# Open checks block Approve/Publish only when this is 1. Default (unset/0) = demo mode:
# checks still run and flag, but uploads can be approved and published with open flags.
# VRE_BLOCKING_CHECKS=1
